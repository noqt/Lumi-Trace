{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reproduction-plan-v1.json",
  "title": "Lumi Trace bounded reproduction plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "limits",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": "reproduction-plan-v1"
    },
    "include_output_preview": {
      "type": "boolean"
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "relativeDirectory": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_seconds",
        "output_bytes",
        "pids",
        "memory_mb",
        "cpus"
      ],
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "pids": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 16,
          "maximum": 65536
        },
        "cpus": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 256
        }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "exit_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "stdout_contains": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000]+$"
        },
        "stderr_contains": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000]+$"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "cwd",
        "expect"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "^[^\\u0000]+$"
          }
        },
        "cwd": {
          "$ref": "#/$defs/relativeDirectory"
        },
        "expect": {
          "$ref": "#/$defs/expectation"
        }
      }
    }
  }
}
