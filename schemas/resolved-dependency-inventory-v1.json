{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resolved-dependency-inventory-v1.json",
  "title": "Lumi Trace resolved dependency inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_name",
    "project_version",
    "runtime_dependency_count",
    "dependencies"
  ],
  "properties": {
    "schema_version": {
      "const": "resolved-dependency-inventory-v1"
    },
    "project_name": {
      "const": "skylark-lumi-trace"
    },
    "project_version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 100,
      "pattern": "^[0-9]+(?:\\.[0-9]+){2}(?:[A-Za-z0-9.!+_-]*)?$"
    },
    "runtime_dependency_count": {
      "const": 0
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    }
  },
  "$defs": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "licence",
        "relationship"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.!+_-]*$"
        },
        "licence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 .+()_;-]*$"
        },
        "relationship": {
          "enum": [
            "direct",
            "transitive"
          ]
        }
      }
    }
  }
}
