{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-package-manifest-v1.json",
  "title": "Lumi Trace evidence package manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifacts", "manifest_id"],
  "properties": {
    "schema_version": {"const": "evidence-package-manifest-v1"},
    "artifacts": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {
            "enum": [
              "normalized-finding.json",
              "repository-index.json",
              "candidates.json",
              "evidence-bundle.json",
              "evidence.sarif",
              "reproduction-plan.json",
              "reproduction-receipt.json"
            ]
          },
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "manifest_id": {"type": "string", "pattern": "^evidence-package:[0-9a-f]{64}$"}
  }
}
