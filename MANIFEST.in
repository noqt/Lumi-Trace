prune docs
prune eval
prune evidence
prune examples
prune schemas
prune scripts
prune tests
exclude model-inventory.yaml

include CODE_OF_CONDUCT.md
include CHANGELOG.md
include CONTRIBUTING.md
include DISCLAIMER.md
include LICENSE
include NOTICE
include README.md
include SECURITY.md
include THIRD_PARTY_NOTICES.md
include docs/ARCHITECTURE.md
include docs/GETTING_STARTED.md
include docs/INPUTS_AND_OUTPUTS.md
include docs/PRIVACY.md
include docs/PRODUCT_SCOPE.md
include docs/README.md
include docs/REPRODUCTION.md
include docs/THREAT_MODEL.md
include docs/reference/SCHEMA_COMPATIBILITY.md
include examples/quickstart/README.md
include examples/quickstart/finding.json
include examples/quickstart/repository/src/archive.py
include schemas/candidate-set-v1.json
include schemas/evidence-bundle-v1.json
include schemas/evidence-package-manifest-v1.json
include schemas/localization-inference-request-v0.4.1.json
include schemas/localization-raw-ranking-v0.4.1.json
include schemas/manual-finding-v1.json
include schemas/normalized-finding-collection-v1.json
include schemas/normalized-finding-v1.json
include schemas/repository-index-v1.json
include schemas/reproduction-plan-v1.json
include schemas/reproduction-receipt-v1.json
recursive-include src *.py
global-exclude *.py[cod]
global-exclude __pycache__
global-exclude .pytest_cache
global-exclude .ruff_cache
